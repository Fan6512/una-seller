{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "options_page": "landing.html",
  "default_locale": "en",
  "background": {
    "service_worker": "assets/js/background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "/assets/img/icon-48.png"
  },
  "icons": {
    "16": "assets/img/icon-16.png",
    "32": "assets/img/icon-32.png",
    "48": "assets/img/icon-48.png",
    "128": "assets/img/icon-128.png",
    "256": "assets/img/icon-256.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "declarativeNetRequestWithHostAccess",
    "contextMenus",
    "alarms",
    "cookies"
  ],
  "homepage_url": "https://www.zying.net",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "assets/js/chunk-vendors.js",
        "assets/js/chunk-common.js",
        "assets/js/content.js"
      ],
      "css": [],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://sellercentral.amazon.com/*",
        "https://sellercentral.amazon.co.uk/*",
        "https://sellercentral.amazon.de/*",
        "https://sellercentral.amazon.fr/*",
        "https://sellercentral.amazon.it/*",
        "https://sellercentral.amazon.es/*",
        "https://sellercentral.amazon.co.jp/*",
        "https://sellercentral.amazon.ca/*",
        "https://sellercentral.amazon.com.mx/*",
        "https://sellercentral.amazon.com.au/*",
        "https://sellercentral.amazon.in/*",
        "https://sellercentral.amazon.ae/*",
        "https://sellercentral.amazon.sa/*",
        "https://sellercentral.amazon.nl/*",
        "https://sellercentral.amazon.se/*",
        "https://sellercentral.amazon.pl/*",
        "https://sellercentral.amazon.sg/*",
        "https://sellercentral.amazon.eg/*",
        "https://sellercentral.amazon.com.tr/*",
        "https://sellercentral.amazon.com.br/*",
        "https://sellercentral.amazon.com.be/*",
        "https://sellercentral.amazon.ie/*",
        "https://sellercentral.amazon.co.za/*",
        "https://sellercentral-europe.amazon.com/*",
        "https://sellercentral-japan.amazon.com/*",
        "https://sellercentral-asia.amazon.com/*"
      ],
      "js": [
        "assets/js/passkey-inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://sellercentral.amazon.com/*",
        "https://sellercentral.amazon.co.uk/*",
        "https://sellercentral.amazon.de/*",
        "https://sellercentral.amazon.fr/*",
        "https://sellercentral.amazon.it/*",
        "https://sellercentral.amazon.es/*",
        "https://sellercentral.amazon.co.jp/*",
        "https://sellercentral.amazon.ca/*",
        "https://sellercentral.amazon.com.mx/*",
        "https://sellercentral.amazon.com.au/*",
        "https://sellercentral.amazon.in/*",
        "https://sellercentral.amazon.ae/*",
        "https://sellercentral.amazon.sa/*",
        "https://sellercentral.amazon.nl/*",
        "https://sellercentral.amazon.se/*",
        "https://sellercentral.amazon.pl/*",
        "https://sellercentral.amazon.sg/*",
        "https://sellercentral.amazon.eg/*",
        "https://sellercentral.amazon.com.tr/*",
        "https://sellercentral.amazon.com.br/*",
        "https://sellercentral.amazon.com.be/*",
        "https://sellercentral.amazon.ie/*",
        "https://sellercentral.amazon.co.za/*",
        "https://sellercentral-europe.amazon.com/*",
        "https://sellercentral-japan.amazon.com/*",
        "https://sellercentral-asia.amazon.com/*"
      ],
      "js": [
        "assets/js/passkey-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://*.zying.net/*",
      "https://zying.net/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/data/*",
        "assets/js/async/*",
        "assets/js/inject-*.js",
        "assets/js/iconfont-zying.js",
        "assets/css/*",
        "assets/css/async/*",
        "assets/img/*",
        "assets/flag/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "version": "5.2.0"
}