# Example only. Copy to /etc/una-seller/api.env (root-owned, mode 0600).
# Obtain DATABASE_URL from your own Supabase Connect screen; use TLS (sslmode=verify-full).
# Direct connection requires IPv6. If this server is IPv4-only use Session Pooler :5432.
DATABASE_URL=
SUPABASE_URL=https://rwktwfxzfkzglxwaulcm.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Mercado Libre CBT: copy the exact fixed HTTPS callback to DevCenter.
# Never commit real secrets. Do not set these on the desktop/client.
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=https://mkd.186512.xyz/api/v1/mercadolibre/oauth/callback
# Base64 of a separately generated 32-byte random key. Store server-side only.
MELI_TOKEN_ENCRYPTION_KEY=
# Set to 1 only if PKCE is enabled on the corresponding DevCenter app.
MELI_PKCE_ENABLED=0
# Keep disabled until all accepted topic handlers are registered, approved migration, proxy source gate,
# and worker/official contract acceptance. Private proxy-to-Go token, not ML signature.
MELI_WEBHOOK_ENABLED=0
# Explicit comma-separated reviewed topics. Empty is invalid when enabled.
# Start with orders/shipments only after separate approval and real acceptance.
MELI_WEBHOOK_TOPICS=
MELI_WEBHOOK_INGRESS_TOKEN=
# Known-resource recheck and missing-new-order discovery; requires enabled worker,
# migrations 0018/0019 and capacity acceptance.
MELI_COMPENSATION_ENABLED=0
# Manual one-page missed-feed replay only; requires separately approved activation.
MELI_MISSED_FEEDS_REPLAY_ENABLED=0

# Chinese reading translations. Choose baidu, azure, or disabled.
# With an empty selector, the existing Azure configuration still works.
TRANSLATION_PROVIDER=
BAIDU_TRANSLATE_APP_ID=
BAIDU_TRANSLATE_SECRET=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Per-user cloud AI/translation credentials. P0 account settings remain DISABLED
# until a separate 32-byte random encryption key is configured on this Go host.
# Generate independently of MELI_TOKEN_ENCRYPTION_KEY; never copy it to desktop.
# Example generating the base64 value locally: openssl rand -base64 32
# KEEP THIS MASTER KEY: losing it makes previously bound user Keys unreadable.
UNA_SELLER_SERVICE_CREDENTIALS_KEY=
# New installs use v1. Change ID together with a new master key; users must rebind
# until data is explicitly re-encrypted. Do not rotate just by editing env.
UNA_SELLER_SERVICE_CREDENTIALS_KEY_ID=v1
# Optional server-operator allowlist: exact HTTPS OpenAI-compatible base URLs,
# comma-separated, e.g. https://api.deepseek.com/v1. OpenAI /v1 is built in.
# Invalid entries are skipped and reported without logging their raw value.
AI_ALLOWED_BASE_URLS=

# Absolute directory shared by the API and manual CBT category updates.
CBT_CATEGORY_DICTIONARY_DIR=

# Optional AI listing copy. Use the provider's OpenAI-compatible API prefix (for example, https://provider.example/v1).
# Select a model that accepts Chat Completions JSON mode (response_format: json_object).
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# FIN-02A: migrate 0023-0025 and verify the runtime role first.
# Enable FX, verify locked rates, then separately enable Billing after approval.
UNA_SELLER_DAILY_FX_ENABLED=0
UNA_SELLER_BILLING_COLLECTOR_ENABLED=0
