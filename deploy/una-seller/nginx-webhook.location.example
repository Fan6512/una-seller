# NOT included by default. WH-06 review template only.
# Place limit_req_zone in http context before enabling:
# limit_req_zone $binary_remote_addr zone=una_meli_webhook:1m rate=20r/s;
# Verify official source ranges immediately before activation. Use actual TCP
# peer (or verified trusted reverse-proxy real-IP configuration); NEVER trust
# caller-supplied X-Forwarded-For or a client-supplied ingress header.
location = /api/v1/mercadolibre/notifications {
    access_log off;
    # Root-owned reviewed allow directives, then deny all.
    # Empty include = nobody authorized. Never insert "allow all".
    include /etc/nginx/una-seller/meli-notification-allow.conf;
    deny all;
    if ($request_method != POST) { return 405; }
    client_max_body_size 16k;
    client_body_timeout 2s;
    limit_req zone=una_meli_webhook burst=40 nodelay;
    limit_req_status 503;
    proxy_pass http://127.0.0.1:8787;
    proxy_set_header Host $host;
    proxy_set_header Authorization "";
    proxy_set_header X-Forwarded-For "";
    # Root-owned 0600 include containing exactly a proxy_set_header
    # X-Una-Webhook-Ingress directive with the server's private token.
    # Nginx replaces caller input; token is NOT an official signature.
    include /etc/nginx/una-seller/meli-notification-ingress.conf;
    proxy_connect_timeout 1s;
    proxy_send_timeout 1s;
    proxy_read_timeout 2s;
    proxy_next_upstream off;
    add_header Cache-Control "no-store" always;
}
