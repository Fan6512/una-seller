[Unit]
Description=Una Seller API
After=network.target

[Service]
Type=simple
User=una-seller
Group=una-seller
WorkingDirectory=/opt/una-seller
EnvironmentFile=-/etc/una-seller/una-seller.env
ExecStart=/opt/una-seller/una-seller-api
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
